{
  "id": "/",
  "name": "Aluminium ERP BD",
  "short_name": "Aluminium ERP",
  "description": "Aluminium ERP BD - Glass & Section Manager Application",
  "start_url": "index.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone"],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "lang": "bn",
  "dir": "ltr",
  "categories": ["business", "productivity", "utilities"],
  "prefer_related_applications": false,
  "related_applications": [{"platform": "play", "id": "com.aluminium.erp"}],
  "iarc_rating_id": "e",
  "note_taking": { "new_note_url": "index.html" },
  "scope_extensions": [{ "origin": "*.github.io" }],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Home Screen"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard View"
    }
  ],
  "shortcuts": [
    {
      "name": "New Invoice",
      "short_name": "Invoice",
      "description": "Create a new invoice",
      "url": "invoice.html",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "purpose": "any" }]
    }
  ],
  "file_handlers": [
    {
      "action": "index.html",
      "accept": { "text/csv": [".csv"] }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+erp",
      "url": "index.html?action=%s"
    }
  ],
  "share_target": {
    "action": "index.html",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "launch_handler": { "client_mode": "focus-existing" },
  "edge_side_panel": { "preferred_width": 400 }
}
